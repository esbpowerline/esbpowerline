// ESB PowerLine Prisma Schema
// Ported & extended from the excellent legacy datastore.js models + BD_PWR_TREE power data models.
// PostgreSQL + full feature parity for Articles, Users/Roles/Permissions, Magazine, Media, Comments, Analytics, + interactive Grid data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USERS + AUTH + ROLES (port of datastore Users + ROLES + hasPermission)
// ============================================
model User {
  id             String     @id @default(cuid())
  supabaseUserId String?    @unique
  name           String
  email          String     @unique
  phone          String?    @unique
  passwordHash   String
  role           Role       @default(AUTHOR)
  pendingName    String?
  avatar         String?
  bio            String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  articlesCount  Int        @default(0)
  totalViews     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  articles         Article[]
  receivedNotices  EditorialNotice[]       @relation("ReceivedNotices")
  sentNotices      EditorialNotice[]       @relation("SentNotices")
  savedItems       SavedItem[]
  memberDownloads  MemberDownload[]
  comments         Comment[]
  gridSubscription MemberGridSubscription?
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
  SUBSCRIBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// ============================================
// ARTICLES (core of the news portal; rich parity with datastore)
// ============================================
model Article {
  id          String        @id @default(cuid())
  title       String
  shortTitle  String?
  slug        String        @unique
  excerpt     String?
  content     String // TipTap JSON or sanitized HTML
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  status      ArticleStatus @default(DRAFT)
  category    String
  categoryId  String?
  categoryRef Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageUrl    String?
  imageCredit String?
  titleBn     String?
  excerptBn   String?
  contentBn   String?

  readTime        Int       @default(1)
  views           Int       @default(0)
  likes           Int       @default(0)
  isFeatured      Boolean   @default(false)
  isBreaking      Boolean   @default(false)
  isPinned        Boolean   @default(false)
  isTrending      Boolean   @default(false)
  postAsNewsDesk  Boolean   @default(false)
  tags            Json? // array of strings stored as JSON (sqlite does not support scalar lists natively in this setup)
  seo             Json? // { metaTitle, metaDescription, focusKeyword, ogImage }
  collaboratorIds Json? // array of user IDs
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(1)
  locale          String    @default("en")
  /**
   * Private editor trash — hidden from admins; purged after 7 days
   */
  editorTrash     Boolean   @default(false)
  trashedAt       DateTime?

  revisions  Revision[]
  notices    EditorialNotice[]
  viewEvents ArticleView[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([isFeatured, status])
  @@index([isTrending, views(sort: Desc)])
  @@index([authorId])
}

/**
 * Append-only pageview ledger — Article.views increments only via recordArticleView().
 */
model ArticleView {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  visitorKey  String
  dedupBucket String   @default("")
  viewedAt    DateTime @default(now())
  referrer    String?

  @@unique([articleId, visitorKey, dedupBucket])
  @@index([articleId, viewedAt])
  @@index([visitorKey, articleId])
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SCHEDULED
  ARCHIVED
  TRASH
}

// ============================================
// CATEGORIES (exact legacy 10)
// ============================================
model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  icon         String?
  iconImageUrl String?
  color        String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  articles     Article[]
}

// ============================================
// EDITORIAL NOTICES (admin → author requests & alerts)
// ============================================
model EditorialNotice {
  id          String                @id @default(cuid())
  type        EditorialNoticeType
  message     String
  status      EditorialNoticeStatus @default(PENDING)
  articleId   String?
  article     Article?              @relation(fields: [articleId], references: [id], onDelete: SetNull)
  recipientId String
  recipient   User                  @relation("ReceivedNotices", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                  @relation("SentNotices", fields: [senderId], references: [id], onDelete: Cascade)
  metadata    Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  trashedAt   DateTime?
}

enum EditorialNoticeType {
  REVISION_REQUEST
  REVIEW_SUBMISSION
  REVIEW_APPROVED
  CONTENT_REMOVED
  CATEGORY_CHANGED
  ADMIN_NOTE
}

enum EditorialNoticeStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// ============================================
// REVISIONS (article history)
// ============================================
model Revision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  content   String
  userId    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([articleId])
}

// ============================================
// MEDIA (images, PDFs for articles + magazine)
// ============================================
model Media {
  id           String   @id @default(cuid())
  name         String
  url          String
  type         String // image | pdf | video
  mimeType     String?
  size         Int?
  altText      String?
  caption      String?
  uploadedById String?
  usedIn       Json? // array of ids stored as JSON for sqlite compatibility
  createdAt    DateTime @default(now())
}

// ============================================
// COMMENTS (moderation)
// ============================================
model Comment {
  id          String        @id @default(cuid())
  articleId   String
  parentId    String?
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String?
  content     String
  status      CommentStatus @default(PENDING)
  likes       Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([articleId])
}

model SavedItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  SavedItemType
  targetId  String
  createdAt DateTime      @default(now())

  @@unique([userId, itemType, targetId])
}

enum SavedItemType {
  ARTICLE
  MAGAZINE
}

model MemberDownload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fileUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/**
 * Paid grid archive subscription — payment webhook activates plan.
 */
model MemberGridSubscription {
  id        String                 @id @default(cuid())
  userId    String                 @unique
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      GridSubscriptionPlan   @default(NONE)
  status    GridSubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

enum GridSubscriptionPlan {
  NONE
  PLAN_499
  PLAN_999
}

enum GridSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CommentStatus {
  APPROVED
  PENDING
  SPAM
  TRASH
}

// ============================================
// MAGAZINE ISSUES
// ============================================
model MagazineIssue {
  id           String   @id @default(cuid())
  title        String
  issueDate    DateTime
  coverUrl     String?
  pdfUrl       String?
  summary      String?
  status       String   @default("published")
  articleLinks Json? // array of article slugs/ids stored as JSON (sqlite compatible)
  createdAt    DateTime @default(now())
}

// ============================================
// POWER GRID / DATA REPORTS (unified from BD_PWR_TREE)
// ============================================
model Node {
  id                String   @id @default(cuid())
  label             String
  designation       String
  category          String
  status            String   @default("normal")
  websiteUrl        String?
  capacityData      String?
  nodeColor         String?
  textColor         String   @default("#e2e8f0")
  x                 Float    @default(0)
  y                 Float    @default(0)
  manualX           Float?
  manualY           Float?
  useManualOverride Boolean  @default(false)
  parentId          String?
  icon              String?
  kpiValue          String?
  kpiUnit           String?
  lastUpdated       String?
  description       String?
  /// Nullable link to the domain entity this node draws (B2, phase 1). A node
  /// with no entity is honestly a diagram node; one with a link stops being
  /// the place a power station's capacity lives as a string in kpiValue.
  entityType        String?
  entityId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent   Node?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Node[] @relation("NodeHierarchy")

  edgesFrom Edge[] @relation("EdgeSource")
  edgesTo   Edge[] @relation("EdgeTarget")

  @@index([entityType, entityId])
}

model Edge {
  id         String   @id @default(cuid())
  sourceId   String
  targetId   String
  edgeColor  String   @default("#64748b")
  edgeStyle  String   @default("solid")
  label      String?
  flowVolume Float?
  flowType   String?
  animated   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  source Node @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
}

// DashboardStat was retired 2026-09-01 (migration 0013). It was a parallel
// database of national figures — value @default(0), a manual-override flag,
// verification recorded as a free string — feeding the admin Sector Snapshot.
// A dashboard consumes authoritative data; that card now renders
// getLatestHomeSnapshot(), the same loaders the public homepage uses.

// ============================================
// SUPPORTING (Logs, Newsletter, Ads, Settings, Pages)
// ============================================
model AuditLog {
  id          String   @id @default(cuid())
  type        String
  message     String
  userId      String?
  undoPayload String?
  // user relation removed to satisfy Prisma validation in current dev setup
  timestamp   DateTime @default(now())
}

model NewsletterSub {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  status       String   @default("active")
}

model Ad {
  id          String    @id @default(cuid())
  name        String
  position    String
  content     String
  link        String    @default("#")
  isActive    Boolean   @default(true)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// (Pages model can be added later for About/Contact custom content)

// ============================================
// PROFILE (Supabase auth.users mirror — id matches UUID from auth.users)
// ============================================
model Profile {
  id        String   @id // matches Supabase auth.users UUID exactly
  fullName  String?
  role      String   @default("MEMBER")
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TAGS (normalized tag lookup)
// ============================================
model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
}

// ============================================
// TICKER ITEMS (live market/news ticker on homepage)
// ============================================
model TickerItem {
  id        String   @id @default(cuid())
  text      String
  url       String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================
// NOTIFICATIONS (user-targeted alerts)
// ============================================
model Notification {
  id        String   @id @default(cuid())
  userId    String // Profile.id
  message   String
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// BOOKMARKS (user article saves — composite key)
// ============================================
model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

// ============================================
// ARTICLE HISTORY (status transition log)
// ============================================
model ArticleHistory {
  id         String   @id @default(cuid())
  articleId  String
  fromStatus String
  toStatus   String
  changedBy  String // Profile.id
  comment    String?
  createdAt  DateTime @default(now())

  @@index([articleId])
}

// ============================================
// CONTACT MESSAGES (user feedback & contact queries)
// ============================================
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String? // Phone Number (WhatsApp)
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// DATA RELEASES (grid + gas data published without a deployment)
//
// Historically every daily report shipped as a static file under public/data
// and therefore needed a rebuild. These tables let a parsed day be staged,
// reviewed and published at runtime instead. The static archive stays exactly
// as it is — it is the substrate the local parser reads and it serves ~6,800
// unchanging days straight from the CDN. Only days published after the last
// deploy live here, and a release always wins over a static file of the same
// key so a correction can supersede a shipped day.
// ============================================

enum DataFeed {
  GRID_DAILY // public/data/daily/{date}.json          (PGCB)
  GAS_DAILY // public/data/petrobangla/daily/{date}.json
  GAS_INDEX // public/data/petrobangla/_index.json
  GAS_LIVE_WEEK // public/data/petrobangla/_live_week.json
  GAS_TIMELINE // public/data/petrobangla/timeline-summary.json
  PGCB_MONTHLY_SERIES // public/data/pgcb-monthly/_series.json
  PGCB_MONTHLY // public/data/pgcb-monthly/{YYYY-MM}.json
  SREDA_DAILY // public/data/sreda/daily/{date}.json
  // A published day is only complete if the Explorer's other tabs can read it
  // too. Without these a newly published day showed its headline figures while
  // the Energy Curve chart and the Power Stations tab silently 404ed, because
  // the ingest writes those as separate files.
  GRID_CURVE // public/data/curves/{date}.json
  GRID_PLANTS // public/data/plants/{date}.json
  PGCB_MONTHLY_EVENTS // public/data/pgcb-monthly/{YYYY-MM}-events.json
  GAS_RESERVE_MODEL // public/data/petrobangla/reserve-model.json
  GAS_RESERVE_SENSITIVITY // public/data/petrobangla/reserve-sensitivity.json
}

/// A parsed payload awaiting review. Transient: cleared once published or discarded.
model DataDraft {
  id            String   @id @default(cuid())
  feed          DataFeed
  /// ISO date for daily feeds, YYYY-MM for monthly, "singleton" for aggregates.
  key           String
  payload       Json
  /// Parser output: reconciliation results, warnings, and anything the
  /// reviewer must see before approving. Shape is owned by the parser.
  validation    Json?
  /// SHA-256 of the canonical payload, so an unchanged re-parse is detectable.
  checksum      String
  sourceName    String? // original upload filename, e.g. "23.07.26.pdf"
  sourceUrl     String? // archived original in Supabase Storage
  parserVersion String?
  createdAt     DateTime @default(now())
  createdById   String?

  @@unique([feed, key])
  @@index([createdAt])
}

/// A published payload. This is what the site serves.
model DataRelease {
  id            String    @id @default(cuid())
  feed          DataFeed
  key           String
  payload       Json
  checksum      String
  sourceName    String?
  sourceUrl     String?
  parserVersion String?
  /// Set when a release is withdrawn; the loader then falls back to the static
  /// archive rather than serving a known-bad day.
  revokedAt     DateTime?
  publishedAt   DateTime  @default(now())
  publishedById String?
  updatedAt     DateTime  @updatedAt

  revisions DataReleaseRevision[]

  @@unique([feed, key])
  @@index([feed, revokedAt])
}

enum RevisionKind {
  PUBLISH // first publish of this feed+key
  CORRECT // payload replaced with different bytes
  REVOKE // withdrawn; loader falls back to the static archive
  RESTORE // re-published after a revoke
}

/// Append-only history of every DataRelease. The current row above answers
/// "what does the site serve"; this table answers "what did we publish last
/// Tuesday, and why did it change" — which @@unique([feed, key]) alone cannot:
/// a correction used to overwrite the previous truth in place, and 2,262 days
/// were corrected in the last week of August 2026 alone. Rows here are never
/// updated or deleted except supersededAt, which is set exactly once.
model DataReleaseRevision {
  id               String       @id @default(cuid())
  releaseId        String
  release          DataRelease  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per release. Assigned in the publish transaction, never reused.
  revision         Int
  /// The full payload as it stood at this revision — not a diff, so a revision
  /// can be served or compared without replaying history.
  payload          Json
  checksum         String
  /// Checksum this revision replaced; null on revision 1.
  previousChecksum String?
  /// Why this changed, human-written. Backfilled rows say so explicitly.
  reason           String
  kind             RevisionKind
  publishedById    String?
  publishedAt      DateTime     @default(now())
  /// Set when the next revision lands; null marks the current revision.
  supersededAt     DateTime?

  @@unique([releaseId, revision])
  @@index([releaseId, publishedAt])
}

// ============================================
// DOMAIN MODEL (B2, phase 1 — additive)
// ============================================
// What the country has, not what the interface draws. Node above holds
// positions, colours and icons; a power station's capacity used to live there
// as a string. These tables are the entities and the observation layer that
// answers: where did this value come from · when was it published · which
// document supports it · was it later corrected · reported or derived · what
// verified it. Phase 1 creates them and links Node by (entityType, entityId);
// nothing reads them yet, so the explorer is unchanged.

enum OrganizationKind {
  OWNER
  OPERATOR
  REGULATOR
  UTILITY
  GOVERNMENT // the ministry node is an organisation too, and none of the above
}

enum FuelKind {
  GAS
  COAL
  HSD
  HFO
  HYDRO
  SOLAR
  WIND
  NUCLEAR
  IMPORT
}

enum ProjectStatus {
  PLANNED
  CONSTRUCTION
  COMMISSIONED
  CANCELLED
}

enum ContractKind {
  PPA
  TARIFF
  SUPPLY
}

enum Publisher {
  PGCB
  PETROBANGLA
  SREDA
  BPDB
}

/// REPORTED: the document states it. DERIVED: computed here from reported
/// figures. The doctrine's reported/derived split, stored rather than implied.
enum ObservationBasis {
  REPORTED
  DERIVED
}

model Organization {
  id        String           @id @default(cuid())
  name      String           @unique
  shortName String?
  kind      OrganizationKind
  country   String           @default("BD")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  plants    PowerPlant[]
  gasFields GasField[]
  contracts Contract[]
}

model PowerPlant {
  id               String    @id @default(cuid())
  name             String    @unique
  organizationId   String?
  fuel             FuelKind
  /// Nameplate as a figure with a source, or null — never a default.
  capacityMw       Decimal?  @db.Decimal(10, 2)
  commissionedOn   DateTime?
  retiredOn        DateTime?
  latitude         Float?
  longitude        Float?
  sourceDocumentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  units          GeneratingUnit[]
  contracts      Contract[]
  projects       PowerProject[]

  @@index([organizationId])
  @@index([fuel])
}

model GeneratingUnit {
  id             String    @id @default(cuid())
  plantId        String
  name           String
  capacityMw     Decimal?  @db.Decimal(10, 2)
  commissionedOn DateTime?
  retiredOn      DateTime?

  plant PowerPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, name])
}

model Substation {
  id        String @id @default(cuid())
  name      String @unique
  voltageKv Int
  latitude  Float?
  longitude Float?

  linesFrom TransmissionLine[] @relation("LineFrom")
  linesTo   TransmissionLine[] @relation("LineTo")
}

model TransmissionLine {
  id               String   @id @default(cuid())
  name             String   @unique
  fromSubstationId String
  toSubstationId   String
  voltageKv        Int
  circuitKm        Decimal? @db.Decimal(10, 2)

  from Substation @relation("LineFrom", fields: [fromSubstationId], references: [id], onDelete: Restrict)
  to   Substation @relation("LineTo", fields: [toSubstationId], references: [id], onDelete: Restrict)

  @@index([fromSubstationId])
  @@index([toSubstationId])
}

model Interconnector {
  id                  String   @id @default(cuid())
  name                String   @unique
  counterpartyCountry String
  capacityMw          Decimal? @db.Decimal(10, 2)
}

/// Seeded from the FIELD_COMPANY map in scripts/fix-gas-rollups.mjs, itself
/// read off days where the rollup and the document agree exactly.
model GasField {
  id            String   @id @default(cuid())
  name          String   @unique
  operatorId    String?
  capacityMmcfd Decimal? @db.Decimal(10, 2)

  operator Organization? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId])
}

model PowerProject {
  id             String        @id @default(cuid())
  name           String        @unique
  status         ProjectStatus
  becomesPlantId String?

  becomesPlant PowerPlant? @relation(fields: [becomesPlantId], references: [id], onDelete: SetNull)

  @@index([becomesPlantId])
}

model Contract {
  id             String       @id @default(cuid())
  kind           ContractKind
  organizationId String
  plantId        String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant        PowerPlant?  @relation(fields: [plantId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([plantId])
}

/// One fetched document: the bytes parsed are the bytes hashed. The same
/// content_sha256 that verify:source pins, promoted to a row.
/// How far a fetched document got through ingestion. A document that was
/// retrieved but never parsed is evidence we hold and have not read; saying so
/// is the difference between a gap we know about and one we do not.
enum IngestStatus {
  FETCHED
  PARSED
  FAILED
}

/// UNVALIDATED: not checked. PASSED: internally consistent. WARNED: the source
/// disagrees with itself — published as filed and reported, never repaired
/// (doctrine rule 4). FAILED: we produced something the source did not say.
enum ValidationStatus {
  UNVALIDATED
  PASSED
  WARNED
  FAILED
}

model SourceDocument {
  id            String    @id @default(cuid())
  publisher     Publisher
  filename      String
  contentSha256 String
  windowStart   DateTime
  windowEnd     DateTime
  fetchedAt     DateTime  @default(now())
  parserVersion String?

  /// The exact endpoint this was retrieved from, including query string. The
  /// filename alone cannot identify a paginated HTML page.
  sourceUrl     String?
  /// The bytes as served, gzipped. This is the evidence: it is what makes a
  /// figure re-derivable years later when the publisher no longer serves the
  /// page. PGCB's demand/load-shed endpoint retains roughly 145 days, so for
  /// that series this column is the only durable copy that will exist.
  rawGzip       Bytes?
  rawByteLength Int?

  ingestStatus     IngestStatus     @default(PARSED)
  validationStatus ValidationStatus @default(UNVALIDATED)
  /// Why a fetch or parse failed, or what the validator warned about.
  note             String?

  observations Observation[]
  plants       PowerPlant[]
  gridHours    GridHourlyObservation[]

  @@unique([publisher, contentSha256])
  @@index([publisher, windowStart])
  @@index([sourceUrl])
}

/// What NLDC's own remark column says this row is.
///
/// Derived from the remark at ingest and stored, never inferred from the
/// timestamp: 6,535 peak stamps sit at :00 and 3,899 :30 rows carry no remark
/// at all, so the minute offset misclassifies roughly a tenth of the series.
/// Generation labels them in Bangla and demand/supply in English, so both
/// vocabularies map here.
///
/// UNCLASSIFIED is load-bearing. A remark this code does not recognise must
/// surface as its own kind rather than folding into REGULAR, because a new
/// vocabulary at the source is exactly the change that would otherwise pass
/// unnoticed into every average.
enum ObservationKind {
  REGULAR
  DAY_PEAK
  EVENING_PEAK
  UNCLASSIFIED
}

/// Why a reported observation is not eligible for aggregation. NULL means it is.
///
/// The source value is NEVER altered — rule 4 says a source's inconsistency is
/// reported, not repaired. This records only ESB's reason for setting a figure
/// aside, and each reason names WHICH figure: one says the printed total cannot
/// be used, the other says the breakdown cannot. Neither condemns the whole row,
/// which is why a bare boolean would have been the wrong shape.
enum AggregationExclusion {
  /// The printed total disagrees with the components printed beside it by more
  /// than 20% — far beyond the rounding that explains 94.4% of rows agreeing
  /// within 0.5%. 370 rows. The clearest is 2023-01-15 05:00, published as
  /// 64526500 against components summing to 6,464 and neighbours near 6,500.
  /// The TOTAL is ineligible; the components remain usable.
  TOTAL_DISAGREES_WITH_COMPONENTS
  /// Every component is printed as a literal zero beside a non-zero total.
  /// 24 rows, all 2015. The BREAKDOWN is ineligible; the total remains usable.
  BREAKDOWN_ALL_ZERO
}

/// Which NLDC hourly page a row came from. They are separate series because
/// they are separate documents with separate retention: generation goes back to
/// 2015, demand/supply/load-shed rolls off after about 145 days.
enum GridSeries {
  GENERATION
  DEMAND_SUPPLY
}

/// One hour as NLDC published it, kept because NLDC will not keep it.
///
/// This is deliberately WIDE rather than the tall `Observation` shape above,
/// and the reason is the charter rather than performance. `Observation.value`
/// is `Decimal` NOT NULL, so absence can only be expressed by the row not
/// existing — which makes "PGCB left this cell blank" and "we never fetched
/// this hour" the same fact. They are not the same fact. Here the row records
/// that the hour was retrieved and each nullable column records whether that
/// figure was printed, so a blank cell survives as `null` and never as `0`.
///
/// `Observation` remains correct for sparse entity attributes. A dense
/// fourteen-column hourly series is not that.
model GridHourlyObservation {
  id     String     @id @default(cuid())
  series GridSeries

  /// The hour NLDC stamps on the row, as an instant. Dhaka is UTC+06:00 all
  /// year with no DST (observation-window.ts), applied uniformly.
  observedAt DateTime
  /// When ESB read the page carrying this row. Kept separate from observedAt
  /// on purpose: the distance between them is how late the archive was, and
  /// collapsing them would erase the only record of that.
  fetchedAt  DateTime

  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  // GENERATION. Every column nullable — a cell NLDC left blank is absent, and
  // absent is never zero.
  totalMw     Decimal? @db.Decimal(12, 3)
  gasMw       Decimal? @db.Decimal(12, 3)
  liquidMw    Decimal? @db.Decimal(12, 3)
  coalMw      Decimal? @db.Decimal(12, 3)
  hydroMw     Decimal? @db.Decimal(12, 3)
  solarMw     Decimal? @db.Decimal(12, 3)
  windMw      Decimal? @db.Decimal(12, 3)
  bheramaraMw Decimal? @db.Decimal(12, 3)
  tripuraMw   Decimal? @db.Decimal(12, 3)
  adaniMw     Decimal? @db.Decimal(12, 3)
  nepalMw     Decimal? @db.Decimal(12, 3)

  // DEMAND_SUPPLY.
  demandMw   Decimal? @db.Decimal(12, 3)
  supplyMw   Decimal? @db.Decimal(12, 3)
  loadShedMw Decimal? @db.Decimal(12, 3)

  /// NLDC's own remark cell — "Day Peak", "Evening Peak" and the like.
  remark        String?
  /// Classified from `remark`, never from the timestamp. See ObservationKind.
  kind          ObservationKind @default(REGULAR)
  /// NULL when the row may be aggregated. See AggregationExclusion.
  excluded      AggregationExclusion?
  basis         ObservationBasis @default(REPORTED)
  parserVersion String
  createdAt     DateTime         @default(now())

  /// The idempotency key. Re-running a backfill, or a poll overlapping a
  /// previous one, must update the hour rather than duplicate it.
  @@unique([series, observedAt])
  @@index([observedAt])
  @@index([sourceDocumentId])
  /// The aggregation read path: regular, eligible rows in a time range.
  @@index([series, kind, excluded, observedAt])
}

/// A figure, its subject, its window and its document. Nothing here may be
/// stored without a sourceDocumentId — an observation nobody published is
/// not an observation.
model Observation {
  id               String           @id @default(cuid())
  sourceDocumentId String
  subjectType      String
  subjectId        String
  metric           String
  value            Decimal          @db.Decimal(14, 4)
  unit             String
  windowStart      DateTime
  windowEnd        DateTime
  basis            ObservationBasis
  createdAt        DateTime         @default(now())

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId, metric, windowStart])
  @@index([sourceDocumentId])
}
