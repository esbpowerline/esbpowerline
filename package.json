{
  "name": "esbpowerline",
  "version": "0.1.0",
  "private": true,
  "description": "ESB PowerLine — Bangladesh's premier energy & power sector news portal, magazine, CMS and full Admin dashboard. Next.js 15 + Prisma + TypeScript + shadcn/ui.",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next .next-public .next-cms .next-admin",
    "dev:public": "cross-env APP_SURFACE=public next dev --webpack -p 3000",
    "dev:cms": "cross-env APP_SURFACE=cms next dev --webpack -p 3001",
    "dev:admin": "cross-env APP_SURFACE=admin next dev --webpack -p 3002",
    "dev:warmup": "node scripts/dev-warmup.mjs",
    "dev:all": "node scripts/ensure-server-action-key.mjs && concurrently -n public,cms,admin,warmup -c blue,green,magenta,yellow --restart-tries 5 --restart-after 3000 \"npm:dev:public\" \"npm:dev:cms\" \"npm:dev:admin\" \"npm:dev:warmup\"",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && node scripts/migrate-deploy-prod.mjs && next build",
    "db:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx --conditions react-server prisma/seed.ts",
    "db:seed:prod": "tsx --conditions react-server prisma/seed-production.ts",
    "supabase:seed-staff": "tsx scripts/seed-supabase-staff.ts",
    "supabase:seed-member": "node scripts/seed-supabase-member.mjs",
    "import:news": "tsx --conditions react-server scripts/import-esbpowerline-news.ts",
    "translate:news": "tsx scripts/translate-articles.ts",
    "backfill:media": "tsx --conditions react-server scripts/backfill-media-library.ts",
    "reset:analytics": "tsx scripts/reset-analytics-and-staff.ts",
    "sync:editor": "tsx scripts/sync-editor-identity.ts",
    "env:pull": "node scripts/env-pull-vercel.mjs",
    "env:sync": "node scripts/sync-env-from-supabase.mjs",
    "setup:agents": "scripts/setup-agent-integrations.cmd",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "check:releases": "tsx --conditions react-server scripts/check-releases.ts",
    "publish:local": "tsx --conditions react-server scripts/publish-local.ts",
    "build:forecast": "python scripts/build_forward_forecast.py",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:reserves": "python scripts/verify_reserve_model.py",
    "build:reserves": "python scripts/build_reserve_model.py --apply && python scripts/reserve_sensitivity.py --json public/data/petrobangla/reserve-sensitivity.json && python scripts/verify_reserve_model.py",
    "backtest:erp": "node scripts/backtest-erp.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:qa": "vitest run lib/test/role-isolation.test.ts lib/test/article-submit.test.ts lib/test/staff-accounts.test.ts lib/test/env-auth.test.ts lib/test/seed-credentials.test.ts lib/test/server-auth.test.ts lib/test/password-reset.test.ts lib/test/security-audit.test.ts lib/test/daily-grid.test.ts lib/test/editorial-limits.test.ts",
    "ingest:sreda": "tsx lib/data/sreda/ingest-sreda.ts",
    "ingest:run": "tsx --conditions react-server scripts/run-ingest.ts",
    "ingest:daemon": "node scripts/ingest-daemon.mjs",
    "ingest:daemon:watch": "node scripts/ingest-daemon.mjs --watch",
    "fix:gas-citations": "node scripts/fix-gas-citations.mjs",
    "backfill:media-sizes": "tsx scripts/backfill-media-sizes.ts",
    "diagnose:prod": "tsx scripts/diagnose-production-state.ts",
    "supabase:sync-passwords": "npm run supabase:seed-staff && npm run supabase:seed-member"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@upstash/ratelimit": "v2.0.8",
    "@upstash/redis": "1.38.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dagre": "0.8.5",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "lucide-react": "0.511.0",
    "next": "16.3.0",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "reactflow": "11.11.4",
    "recharts": "3.10.1",
    "sanitize-html": "2.17.6",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/dagre": "0.7.54",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.3.3",
    "lighthouse": "13.4.1",
    "mupdf": "^1.26.4",
    "postcss": "8.5.26",
    "puppeteer": "25.5.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vercel": "54.21.1",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  },
  "overrides": {
    "react-is": "$react-is",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "deepmerge-ts": "8.0.0"
  }
}
